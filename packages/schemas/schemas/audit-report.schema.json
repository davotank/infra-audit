{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra-audit.example/schemas/audit-report/v1.json",
  "title": "Independent engineering audit report (v1)",
  "description": "Filed by the assigned auditor through TreasuryVault.submitReport(tenderId, reportCID). Unlike citizens, auditors are identified on purpose: their professional accountability is what gives the report its weight.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenderId", "chainId", "auditor", "inspection", "tests", "verdict", "reportPdf", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "tenderId": { "type": "integer", "minimum": 1 },
    "chainId": { "type": "integer" },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "wallet", "credential"],
      "properties": {
        "name": { "type": "string" },
        "wallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "description": "Must equal the auditor assigned on-chain." },
        "credential": { "type": "string", "description": "e.g. Institution of Engineers (India) membership no., or the NABL accreditation no. of the testing lab" },
        "lab": { "type": "string" },
        "conflictOfInterestDeclaration": { "type": "boolean" }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "chainagesInspected"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "chainagesInspected": { "type": "array", "items": { "type": "string" }, "description": "e.g. '0+200', '0+850'" },
        "photos": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "standard", "specified", "measured", "unit", "pass"],
        "properties": {
          "name": { "type": "string", "examples": ["Bituminous course thickness (core)", "Bitumen content", "Concrete cube compressive strength"] },
          "standard": { "type": "string", "examples": ["IRC:SP:11", "MoRTH Sec. 500", "IS 516"] },
          "location": { "type": "string" },
          "specified": { "type": "number" },
          "measured": { "type": "number" },
          "unit": { "type": "string" },
          "pass": { "type": "boolean" }
        }
      }
    },
    "verdict": { "enum": ["conforms", "minor_deviations", "major_deviations", "fails_specification"] },
    "summary": { "type": "string" },
    "reportPdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cid", "sha256"],
      "properties": { "cid": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "description": "EIP-712 signature by auditor.wallet over this document with the signature field removed (canonical JSON, RFC 8785).",
      "properties": {
        "scheme": { "const": "eip712-jcs-v1" },
        "value": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra-audit.example/schemas/tender/v1.json",
  "title": "Tender metadata (v1)",
  "description": "Pinned to IPFS. Its CID is stored in TenderRegistry.metadataCID. Only public procurement data. Never store an individual's personal data here (see docs/design-review.md, DPDP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "tender", "contractor", "award", "location", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portal", "url", "retrievedAt", "method"],
      "properties": {
        "portal": { "enum": ["CPPP", "KPPP", "MAHATENDERS", "GEM", "OTHER"], "description": "CPPP = eprocure.gov.in; KPPP = Karnataka; MAHATENDERS = Maharashtra" },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "method": { "enum": ["manual", "scraper", "oracle"] },
        "onboardedBy": { "type": "string", "description": "Steward handle or oracle job id. Not a personal name." }
      }
    },
    "tender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceNumber", "title", "department", "category"],
      "properties": {
        "referenceNumber": { "type": "string", "minLength": 1, "description": "Portal tender reference; keccak256(referenceNumber) == TenderRegistry.externalRefHash" },
        "portalTenderId": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "department": { "type": "string" },
        "category": { "enum": ["road", "bridge", "flyover", "drainage", "water_supply", "building", "footpath", "streetlight", "other"] },
        "description": { "type": "string" },
        "publishedOn": { "type": "string", "format": "date" }
      }
    },
    "contractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "idType", "idValue"],
      "properties": {
        "name": { "type": "string", "description": "Registered firm name as published on the portal." },
        "idType": { "enum": ["GSTIN", "PAN_FIRM", "PORTAL_ID"] },
        "idValue": { "type": "string", "description": "Normalised (upper-case, trimmed). keccak256(idType + ':' + idValue) == TenderRegistry.contractorIdHash" },
        "entityType": { "enum": ["company", "llp", "partnership", "proprietorship", "jv", "government", "unknown"], "description": "Proprietorships are individuals under DPDP. Get a legal review before publishing these." }
      },
      "allOf": [
        {
          "if": { "properties": { "idType": { "const": "GSTIN" } } },
          "then": { "properties": { "idValue": { "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" } } }
        }
      ]
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimatedValuePaise", "awardedValuePaise", "awardedOn", "scheduledCompletion"],
      "properties": {
        "estimatedValuePaise": { "type": "integer", "minimum": 0 },
        "awardedValuePaise": { "type": "integer", "minimum": 0, "description": "Must equal TenderRegistry.awardedValuePaise" },
        "awardedOn": { "type": "string", "format": "date" },
        "scheduledCompletion": { "type": "string", "format": "date" },
        "defectLiabilityMonths": { "type": "integer", "minimum": 0, "description": "The contractor must fix defects found within this period after completion. This is the main lever for citizen reports." },
        "fundingScheme": { "type": "string", "description": "e.g. Smart Cities Mission, PMGSY, municipal budget" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pincode", "ward", "city", "state"],
      "properties": {
        "pincode": { "type": "string", "pattern": "^[1-9][0-9]{5}$" },
        "ward": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "geometry": {
          "description": "GeoJSON geometry of the work site (a LineString for a road).",
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Point", "LineString", "Polygon", "MultiLineString"] },
            "coordinates": { "type": "array" }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "cid", "sha256"],
        "properties": {
          "kind": { "enum": ["nit", "boq", "work_order", "agreement", "drawing", "corrigendum", "completion_certificate", "other"] },
          "cid": { "type": "string", "minLength": 46 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the file as downloaded from the portal, so the mirror can be checked against the source." },
          "sourceUrl": { "type": "string", "format": "uri" },
          "mimeType": { "type": "string" }
        }
      }
    },
    "specifications": {
      "description": "Key measurable specs from the BOQ. Auditors check work against these.",
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] },
      "examples": [{ "lengthMetres": 1200, "carriagewayWidthMetres": 7, "bituminousConcreteThicknessMm": 40, "dbmThicknessMm": 50 }]
    }
  }
}
